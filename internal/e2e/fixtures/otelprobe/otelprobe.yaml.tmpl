# The k8s half of the otelprobe fixture. One replica puts every actor on the
# same worker, so they take successive telemetry slots.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e-otelprobe${FIXTURE_SUFFIX}
  labels:
    ate.dev/e2e: "true"

---

apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: otelprobe
  namespace: ate-e2e-otelprobe${FIXTURE_SUFFIX}
  labels:
    workload: otelprobe${FIXTURE_SUFFIX}
spec:
  replicas: 1
  workerImage: ${WORKER_IMAGE}
  template:
    # Three actors' worth of CPU.
    resources:
      limits:
        cpu: "3"
        memory: 1Gi
      requests:
        cpu: 500m
        memory: 1Gi
${WORKERPOOL_RUNTIME}
