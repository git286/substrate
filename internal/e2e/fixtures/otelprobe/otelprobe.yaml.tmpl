# The k8s half of the otelprobe fixture: the namespace and the WorkerPool. The
# ActorTemplate is the substrate resource in otelprobe-template.yaml.tmpl,
# created through the ate API by e2e.DeploySubstrateFixture.
#
# Rendered by e2e.RenderFixtureManifest, which fills the ${...} placeholders for
# the sandbox class under test.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e-otelprobe${FIXTURE_SUFFIX}
  labels:
    ate.dev/e2e: "true"

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: otelprobe
  namespace: ate-e2e-otelprobe${FIXTURE_SUFFIX}
  labels:
    workload: otelprobe${FIXTURE_SUFFIX}
spec:
  replicas: 2
  workerImage: ${ATEOM_IMAGE}
${WORKERPOOL_RUNTIME}
