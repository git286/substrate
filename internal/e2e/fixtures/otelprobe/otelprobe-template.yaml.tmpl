# The otelprobe fixture's ActorTemplate: a protojson-shaped
# ateapipb.ActorTemplate created through the ate API by
# e2e.DeploySubstrateFixture after ko resolve pins the image. The template
# sets no OTEL_* env of its own: the point is that the platform's defaults
# alone point the SDK at the relay.

metadata:
  atespace: ate-e2e-otelprobe${FIXTURE_SUFFIX}
  name: otelprobe
workerSelector:
  matchLabels:
    workload: otelprobe${FIXTURE_SUFFIX}
containers:
- name: otelprobe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/otelprobe
  command: ["/ko-app/otelprobe"]
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
${TEMPLATE_RESOURCES}
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e-otelprobe${FIXTURE_SUFFIX}/
