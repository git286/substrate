# The otelprobe fixture's ActorTemplate. It sets no OTEL_* variable: the
# exporter configuration is the platform's.

metadata:
  atespace: ate-e2e-otelprobe${FIXTURE_SUFFIX}
  name: otelprobe
workerSelector:
  matchLabels:
    workload: otelprobe${FIXTURE_SUFFIX}
containers:
- name: otelprobe
  image: ko://go.ate.dev/substrate/internal/e2e/fixtures/otelprobe
  command: ["/ko-app/otelprobe"]
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 268435456 # 256Mi
snapshotConfig:
  # MEMORY, so the golden snapshot holds the SDK's start time and counters.
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
